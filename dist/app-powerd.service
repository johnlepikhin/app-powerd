[Unit]
Description=App Power Daemon - Background App Power Management
Documentation=https://github.com/user/app-powerd
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/app-powerd run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# On stop the daemon resumes every process it suspended before exiting. That is
# not optional work: SIGSTOP cannot be undone by the stopped process, so being
# killed part-way leaves them stranded. Give it room to finish.
TimeoutStopSec=30
KillSignal=SIGTERM

# The freeze journal lives in $XDG_RUNTIME_DIR/app-powerd/, covered by
# ReadWritePaths=%t below. It records what is suspended so a crashed daemon's
# victims can be resumed on the next start.

# Environment
Environment=RUST_LOG=info

# Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
PrivateTmp=true
NoNewPrivileges=true

# Resource limits
MemoryMax=50M
CPUQuota=5%

[Install]
WantedBy=graphical-session.target
